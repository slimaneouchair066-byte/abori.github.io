<!-- contact.html - صفحة اتصل بنا -->
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>اتصل بنا | طقس العالم</title>
    <link rel="stylesheet" href="style.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <style>
        /* تنسيقات خاصة بصفحات من نحن، اتصل بنا، سياسة الخصوصية */
        .page-header {
            text-align: center;
            padding: 30px 0 10px;
        }
        .page-header h1 {
            font-size: 2.2rem;
            margin-bottom: 6px;
        }
        .page-header p {
            color: #b6d4e0;
            font-size: 1.05rem;
        }
        .page-content {
            background: rgba(10, 30, 45, 0.35);
            backdrop-filter: blur(8px);
            border-radius: 32px;
            padding: 30px 28px;
            border: 1px solid rgba(255, 215, 150, 0.1);
            margin: 20px 0 30px;
            line-height: 1.9;
        }
        .page-content h2 {
            color: #f5d7a0;
            margin: 25px 0 12px;
            font-size: 1.4rem;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .page-content h2 i {
            color: #f5b342;
        }
        .page-content p {
            margin-bottom: 14px;
            opacity: 0.92;
        }
        .page-content ul {
            list-style: none;
            padding-right: 10px;
        }
        .page-content ul li {
            padding: 8px 0 8px 20px;
            border-bottom: 1px solid rgba(255,255,255,0.04);
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .page-content ul li i {
            color: #f5b342;
            width: 24px;
            text-align: center;
        }
        .contact-card {
            background: rgba(0,0,0,0.2);
            border-radius: 24px;
            padding: 20px 24px;
            margin: 16px 0;
            border-right: 4px solid #f5b342;
            transition: 0.3s;
        }
        .contact-card:hover {
            background: rgba(0,0,0,0.3);
            transform: translateX(-4px);
        }
        .contact-card .label {
            color: #8dc9e0;
            font-size: 0.85rem;
        }
        .contact-card .value {
            font-size: 1.1rem;
            font-weight: 600;
            color: #f5d7a0;
        }
        .back-home {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: rgba(245, 179, 66, 0.15);
            border: 1px solid rgba(245, 179, 66, 0.3);
            border-radius: 60px;
            padding: 10px 28px;
            color: #f5d7a0;
            text-decoration: none;
            font-weight: 600;
            transition: 0.3s;
            margin-top: 15px;
        }
        .back-home:hover {
            background: rgba(245, 179, 66, 0.25);
            transform: translateY(-2px);
        }
        .footer-links {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            justify-content: center;
            margin-top: 25px;
            padding-top: 20px;
            border-top: 1px solid rgba(255,255,255,0.06);
        }
        .footer-links a {
            color: #b6d4e0;
            text-decoration: none;
            font-size: 0.95rem;
            transition: 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .footer-links a:hover {
            color: #f5b342;
        }
        .footer-links a.active {
            color: #f5b342;
            font-weight: 600;
        }
        /* تحسين للشاشات الصغيرة */
        @media (max-width: 600px) {
            .page-content {
                padding: 20px 16px;
            }
            .page-header h1 {
                font-size: 1.7rem;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- رأس الصفحة مع روابط التنقل -->
        <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; margin-bottom: 10px;">
            <a href="index.html" style="color: #f5b342; font-size: 1.4rem; font-weight: 700; text-decoration: none;">
                <i class="fas fa-cloud-sun"></i> طقس العالم
            </a>
            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                <a href="about.html" class="footer-links-link" style="color: #b6d4e0; text-decoration: none; padding: 6px 14px; border-radius: 30px; transition:0.3s; font-size:0.9rem;">من نحن</a>
                <a href="contact.html" class="footer-links-link active" style="color: #f5b342; text-decoration: none; padding: 6px 14px; border-radius: 30px; background: rgba(245,179,66,0.12); font-size:0.9rem;">اتصل بنا</a>
                <a href="privacy.html" class="footer-links-link" style="color: #b6d4e0; text-decoration: none; padding: 6px 14px; border-radius: 30px; transition:0.3s; font-size:0.9rem;">سياسة الخصوصية</a>
            </div>
        </div>

        <!-- محتوى الصفحة -->
        <div class="page-header">
            <h1><i class="fas fa-phone-alt" style="color: #f5b342; margin-left: 12px;"></i>اتصل بنا</h1>
            <p>نسعد بتواصلكم معنا – فريق طقس العالم في خدمتكم</p>
        </div>

        <div class="page-content">
            <h2><i class="fas fa-envelope"></i> طرق التواصل</h2>
            
            <div class="contact-card">
                <div class="label"><i class="fas fa-envelope"></i> البريد الإلكتروني</div>
                <div class="value">support@weather-world.com</div>
            </div>
            
            <div class="contact-card">
                <div class="label"><i class="fas fa-phone"></i> الهاتف</div>
                <div class="value">+212 5 22 33 44 55</div>
            </div>
            
            <div class="contact-card">
                <div class="label"><i class="fab fa-whatsapp"></i> واتساب</div>
                <div class="value">+212 6 11 22 33 44</div>
            </div>

            <h2 style="margin-top: 30px;"><i class="fas fa-map-marker-alt"></i> المقر الرئيسي</h2>
            <p>الدار البيضاء، المغرب – شارع محمد الخامس، برج الأعمال رقم 12</p>
            
            <h2><i class="fas fa-clock"></i> ساعات العمل</h2>
            <p>الإثنين – الجمعة: 09:00 – 18:00 (بتوقيت المغرب)<br />
            السبت: 10:00 – 14:00</p>

            <h2><i class="fas fa-share-alt"></i> تابعنا على</h2>
            <div style="display: flex; gap: 18px; font-size: 1.8rem; margin-top: 8px;">
                <a href="#" style="color: #7fc1db; transition:0.3s;"><i class="fab fa-facebook"></i></a>
                <a href="#" style="color: #7fc1db; transition:0.3s;"><i class="fab fa-twitter"></i></a>
                <a href="#" style="color: #7fc1db; transition:0.3s;"><i class="fab fa-instagram"></i></a>
                <a href="#" style="color: #7fc1db; transition:0.3s;"><i class="fab fa-youtube"></i></a>
            </div>

            <!-- نموذج تواصل سريع -->
            <h2 style="margin-top: 30px;"><i class="fas fa-paper-plane"></i> أرسل رسالة</h2>
            <form style="display: flex; flex-direction: column; gap: 14px; max-width: 500px;">
                <input type="text" placeholder="الاسم الكامل" style="padding: 14px 18px; border-radius: 30px; border: 1px solid rgba(255,215,150,0.2); background: rgba(255,255,255,0.04); color: #fff; font-size:1rem;" />
                <input type="email" placeholder="البريد الإلكتروني" style="padding: 14px 18px; border-radius: 30px; border: 1px solid rgba(255,215,150,0.2); background: rgba(255,255,255,0.04); color: #fff; font-size:1rem;" />
                <textarea rows="4" placeholder="نص الرسالة..." style="padding: 14px 18px; border-radius: 24px; border: 1px solid rgba(255,215,150,0.2); background: rgba(255,255,255,0.04); color: #fff; font-size:1rem; resize:vertical;"></textarea>
                <button type="submit" class="btn-primary" style="width: fit-content; padding: 14px 40px;">
                    <i class="fas fa-paper-plane"></i> إرسال
                </button>
            </form>
        </div>

        <!-- روابط التذييل -->
        <div class="footer-links">
            <a href="about.html"><i class="fas fa-info-circle"></i> من نحن</a>
            <a href="contact.html" class="active"><i class="fas fa-phone"></i> اتصل بنا</a>
            <a href="privacy.html"><i class="fas fa-shield-alt"></i> سياسة الخصوصية</a>
            <a href="index.html"><i class="fas fa-home"></i> الرئيسية</a>
        </div>
        
        <div class="footer-note">© 2026 طقس العالم – جميع الحقوق محفوظة</div>
    </div>
</body>
</html>
